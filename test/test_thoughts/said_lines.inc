{8, 148, 4, 1, 7, "TURBO MODE! NO BRAKES!"},
{8, 149, 4, 0, 7, "OOH. NICE PARTS."},
{8, 149, 4, 1, 7, "A BEETLE. DOES IT RUN?"},
{8, 150, 4, 0, 7, "IN MY BOX. CLOSED SHOP."},
{8, 150, 4, 1, 7, "GOGGLES DOWN. INVISIBLE."},
{8, 151, 4, 0, 7, "RUSTY SNACK. NO THANKS."},
{8, 151, 4, 1, 7, "EVEN THE BIN SAYS NO."},
