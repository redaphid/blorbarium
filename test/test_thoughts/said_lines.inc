{8, 106, 4, 0, 7, "SO BRIGHT. GOGGLES DOWN."},
{8, 107, 4, 0, 7, "WARM GLASS. GOOD FOR GLUE."},
{8, 108, 4, 0, 7, "DAYTIME. WORKSHOP CLOSED."},
{8, 109, 4, 0, 7, "LUNCH. I'LL CHECK THE BIN."},
{8, 110, 4, 0, 7, "MY SHADOW HAS A MASK TOO."},
{8, 111, 4, 0, 7, "BIG DAY. BIG NAP FIRST."},
{8, 112, 4, 0, 7, "LIGHT ON MY GOGGLES. SHINY."},
{8, 113, 4, 0, 7, "IS OUTSIDE ONE BIG BIN?"},
{8, 114, 4, 0, 7, "IT IS DARK. MY HOURS."},
{8, 115, 4, 0, 7, "THE STARS ARE SPARE BOLTS."},
{8, 116, 4, 0, 7, "UP LATE. ALWAYS. IT'S NORMAL."},
{8, 117, 4, 0, 7, "SO QUIET. NOW I CAN TINKER."},
{8, 118, 4, 0, 7, "WHAT WAS THAT? A BIN LID?"},
{8, 119, 4, 0, 7, "BED AT DAWN. IN A BOX."},
{8, 120, 4, 0, 7, "THE MOON WINKED. I GLINTED."},
{8, 121, 4, 0, 7, "NIGHT SNACKS. FROM THE BIN."},
{8, 122, 4, 0, 7, "MY GOGGLES GLOW. I BUILT THAT."},
{8, 123, 4, 0, 7, "EVERYONE SLEEPS. I TINKER."},
{8, 124, 4, 0, 7, "ZZZ... CLANK... ZZZ... CLANK"},
{8, 124, 4, 1, 7, "ZZZ... WHIRR... ZZZ... WHIRR"},
{8, 124, 4, 2, 7, "ZZZ... BEEP... BOOP... ZZZ..."},
{8, 125, 4, 0, 7, "MMF... PASS THE WRENCH..."},
{8, 125, 4, 1, 7, "MMF... DON'T TIDY MY PILE..."},
{8, 125, 4, 2, 7, "MMF... MORE TAPE... MORE..."},
{8, 126, 4, 0, 7, "ZZZ... COME BACK, SCREW..."},
{8, 126, 4, 1, 7, "ZZZ... THAT WAS MY BOLT! HEY!"},
{8, 126, 4, 2, 7, "ZZZ... CATCH THAT SPRING..."},
{8, 127, 4, 0, 7, "ZZZ... THE BIGGEST BIN EVER..."},
{8, 127, 4, 1, 7, "ZZZ... SNACKS ON A CONVEYOR..."},
{8, 127, 4, 2, 7, "ZZZ... A SANDWICH MACHINE..."},
{8, 128, 4, 0, 7, "ZZZ... MY ROCKET WORKS!"},
{8, 128, 4, 1, 7, "ZZZ... GOGGLES ON... LIFTOFF!"},
{8, 128, 4, 2, 7, "ZZZ... A HELICOPTER HAT..."},
{8, 129, 4, 0, 7, "ONE BOLT, TWO BOLT, NUT..."},
{8, 129, 4, 1, 7, "ONE SCREW... TWO... MISSING?"},
{8, 129, 4, 2, 7, "ZZZ... COUNTING SPROCKETS..."},
{8, 130, 4, 0, 7, "MMM... GOOD BOX. COSY BOX..."},
{8, 130, 4, 1, 7, "MMM... WARM OIL... SNUG CAP..."},
{8, 130, 4, 2, 7, "MMM... TAIL BLANKET. NICE..."},
{8, 131, 4, 0, 7, "ZZZ... RAIN... NO... RUST..."},
{8, 131, 4, 1, 7, "ZZZ... TARP OVER THE PILE..."},
{8, 131, 4, 2, 7, "ZZZ... I BUILT AN UMBRELLA..."},
{8, 132, 4, 0, 7, "TO FIGHT, HOLD ME UPSIDE DOWN."},
{8, 133, 4, 0, 7, "SHAKE ME. I SEE PARTS. NICE."},
{8, 134, 4, 0, 7, "KNOCK KNOCK ON ME. SNACKS OUT."},
{8, 134, 4, 1, 7, "KNOCK TWICE. THE SNACK HATCH."},
{8, 134, 4, 2, 7, "TWO KNOCKS: FOOD. I WIRED IT."},
{8, 134, 4, 3, 7, "HUNGRY? KNOCK KNOCK ON ME."},
{8, 135, 4, 0, 7, "HOLD ME SIDEWAYS. NAP IN A BOX"},
{8, 136, 4, 0, 7, "WHISTLE WHILE YOU WRENCH."},
{8, 136, 4, 1, 7, "LA LA. HAND ME THAT BOLT."},
{8, 137, 4, 0, 7, "THE ROBOT. I BUILT IT."},
{8, 137, 4, 1, 7, "GOGGLES DOWN. DANCE MODE."},
{8, 138, 4, 0, 7, "THAT TAIL'S A SPARE PART."},
{8, 138, 4, 1, 7, "STRIPED THIEF! GET BACK!"},
{8, 139, 4, 0, 7, "A BOLT! NICE PARTS!"},
{8, 139, 4, 1, 7, "DIGGING FOR SCRAP. SCORE."},
{8, 140, 4, 0, 7, "NICE FACE. GOT ANY PARTS?"},
{8, 140, 4, 1, 7, "PEEKING. GOGGLES ON."},
{8, 141, 4, 0, 7, "HYAH! WRENCH ARM! HYAH!"},
{8, 141, 4, 1, 7, "BANDIT MOVES. TAKE THAT."},
{8, 142, 4, 0, 7, "PEBBLE. GEAR. PEBBLE. GEAR."},
{8, 142, 4, 1, 7, "JUGGLING. TESTING GRAVITY."},
{8, 143, 4, 0, 7, "A MACHINE THAT MAKES SNACKS."},
{8, 143, 4, 1, 7, "WHAT IF THE DISH HAD WHEELS?"},
{8, 144, 4, 0, 7, "WORKSHOP'S OPEN. STARS ARE UP"},
{8, 144, 4, 1, 7, "I COULD FIX THAT STAR."},
{8, 145, 4, 0, 7, "ACHOO! OIL. IN MY NOSE."},
{8, 145, 4, 1, 7, "AH-CHOO! DUST IN THE GEARS."},
{8, 146, 4, 0, 7, "BOO! BANDIT ATTACK!"},
{8, 146, 4, 1, 7, "BOO! FOUND YOU IN A BIN!"},
{8, 147, 4, 0, 7, "HIC. LOOSE SCREW. HIC."},
