{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blorbarium",
  "compatibility_date": "2026-10-01",
  // The site is static (public/); the Worker answers /api/* and the owner's dashboard at /admin.
  "main": "src/worker.js",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin", "/admin/*"] },
  "routes": [{ "pattern": "blorb.hypnodroid.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Workers AI: the two calls that write a pet's character and lines.
  "ai": { "binding": "AI" },
  // Every badge, creature, personality and pack (migrations/). The database is
  // created on first deploy (or: npx wrangler d1 create blorbarium, then put its id here).
  "d1_databases": [{ "binding": "DB", "database_name": "blorbarium", "migrations_dir": "migrations" }],
  // Per badge (keyed by MAC): a few requests a minute.
  "ratelimits": [{ "name": "PET_LINES_LIMITER", "namespace_id": "3701", "simple": { "limit": 6, "period": 60 } }],
  // Every 10 minutes: the packs a badge asked for without waiting. Daily at 04:00 UTC: diaries (#39).
  "triggers": { "crons": ["*/10 * * * *", "0 4 * * *"] },
  "vars": {
    "LINES_MODEL": "@cf/moonshotai/kimi-k2.6",
    "LINES_PROMPT": "v2",
    "MAX_GENERATIONS_PER_DAY": "6"
  }
  // Secrets (npx wrangler secret put ...): ADMIN_TOKEN (GET /api/creatures),
  // PACK_SIGNING_KEY (P-256 PKCS#8, base64; packs go unsigned without it).
}
