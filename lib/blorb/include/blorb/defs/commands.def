// Phone verbs. A row plus a handler cmd_<name> in src/protocol.cpp is the
// whole change. Flags: kMutating marks the keepsake dirty; kConsent needs a
// physical button hold on the device inside a 20 s window.
//
// BLORB_CMD(VERB, name, flags)
BLORB_CMD(HELLO,    hello,    0)
BLORB_CMD(SCHEMA,   schema,   0)
BLORB_CMD(STATE,    state,    0)
BLORB_CMD(CHEM,     chem,     0)
BLORB_CMD(GENOME,   genome,   0)
BLORB_CMD(GENE,     gene,     0)
BLORB_CMD(EDIT,     edit,     kMutating)
BLORB_CMD(NAME,     name,     kMutating)
BLORB_CMD(STIM,     stim,     kMutating)
BLORB_CMD(BRAIN,    brain,    0)
BLORB_CMD(LINEAGE,  lineage,  0)
BLORB_CMD(ANCESTOR, ancestor, 0)
BLORB_CMD(DIFF,     diff,     0)
BLORB_CMD(PORTRAIT, portrait, 0)
BLORB_CMD(CLUTCH,   clutch,   0)
BLORB_CMD(PICK,     pick,     kMutating)
BLORB_CMD(TIME,     time,     kMutating)
BLORB_CMD(SUB,      sub,      0)
BLORB_CMD(BACKUP,   backup,   0)
BLORB_CMD(RESTORE,  restore,  kMutating | kConsent)
BLORB_CMD(HASH,     hash,     0)
