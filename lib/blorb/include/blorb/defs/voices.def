// Voices: the way he says things. The oracle gene picks one (its byte taken
// modulo the rows), so siblings can talk differently and a lineage drifts.
// A terse voice (`firstOnly`) keeps just the first sentence of a shared line;
// that is all a voice does. Nothing wraps or rewrites a line: no prefix, no
// suffix, no frame, no voice's own version (the owner asked: no
// "THE REEDS SAY:", no "... SO IT IS.").
// Stable ids: never renumber, never reuse.
// BLORB_VOICE(id, name, firstOnly)
#ifdef BLORB_VOICE
BLORB_VOICE(0, terse,         1)
BLORB_VOICE(1, ominous,       0)
BLORB_VOICE(2, rambling,      0)
BLORB_VOICE(3, cheerful_doom, 0)
BLORB_VOICE(4, hoarder,       0)
BLORB_VOICE(5, mystic,        0)
#endif
