BLORB_LINE(p_pond_yes,     ominous,       "WATCH YOUR BACK.")
BLORB_LINE(p_pond_yes,     rambling,      "THE TRUTH BEHIND THAT LAST ONE.")
BLORB_LINE(p_pond_yes,     rambling,      "THIS POND HAS LIZARDS.")
BLORB_LINE(p_pond_yes,     cheerful_doom, "AH THERE IT WAS!")
BLORB_LINE(p_pond_yes,     cheerful_doom, "COLONISTS SAY: SEE YOU IN SILT")
BLORB_LINE(p_pond_yes,     cheerful_doom, "HOW DO YOU BREATHE?")
BLORB_LINE(p_pond_yes,     cheerful_doom, "THE BIG ONE ARRIVED TODAY!")
BLORB_LINE(p_pond_yes,     hoarder,       "IT MUST HAVE BEEN A FROG.")
BLORB_LINE(p_pond_yes,     hoarder,       "THE BOG KING COULD BE ANYONE.")
BLORB_LINE(p_pond_yes,     mystic,        "LO! A RIPPLE FROM AFAR!")
BLORB_LINE(p_pond_yes,     mystic,        "THE FIELD-NOTEBOOK IS FULL.")
BLORB_LINE(p_pond_yes,     mystic,        "WHAT'S THAT? SAYS GRUNGO?")
BLORB_LINE(p_ripples,      terse,         "HMM! IT WENT AWAY")
BLORB_LINE(p_ripples,      terse,         "LATER! WHEN THE LILY? WARM MUD!")
BLORB_LINE(p_ripples,      terse,         "MM HM HM.")
BLORB_LINE(p_ripples,      terse,         "WOBBLY PUDDLE HMMMMM")
BLORB_LINE(p_ripples,      ominous,       "THE BOG WILL HOLD ITS BREATH.")
BLORB_LINE(p_ripples,      ominous,       "WHAT DID YOU HEAR?")
BLORB_LINE(p_ripples,      ominous,       "WHAT'S NEXT? BETTER THINGS?")
BLORB_LINE(p_ripples,      rambling,      "AND NOW IN A FINAL NOTE")
BLORB_LINE(p_ripples,      rambling,      "WHERE GRUNGO LIVES ARE HOLES.")
BLORB_LINE(p_ripples,      cheerful_doom, "GOOD TO KNOW, POND. ALWAYS.")
BLORB_LINE(p_ripples,      cheerful_doom, "HEY, WARM BATH IN THE POND. ICK.")
BLORB_LINE(p_ripples,      cheerful_doom, "SILT HERE BUT NOT THERE.")
BLORB_LINE(p_ripples,      cheerful_doom, "THANK GOD FOR LILY.")
BLORB_LINE(p_ripples,      hoarder,       "GRUNGO FINDS ONE NEW RIPPLE.")
BLORB_LINE(p_ripples,      hoarder,       "WHEN WAS THAT?")
BLORB_LINE(p_ripples,      mystic,        "THE BUBBLES SPOKE THIS WEEK.")
BLORB_LINE(p_ripples,      mystic,        "THERE COMES A SOUND, FAINT.")
