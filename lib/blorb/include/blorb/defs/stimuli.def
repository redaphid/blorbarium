// Stimuli: numbered events. What one does to THIS creature is its stimulus
// genes, not code. Ids are < 64; stim s owns recent locus 64 + s.
//   Body  : an IMU or BOOT detector. No phone needed.
//   World : the habitat, the pet clock, the link. No phone needed.
//   Self  : fired by the creature's own action.
//   Phone : the STIM verb may fire it. Extras only: no core loop needs one,
//           and the host test body_only_full_life runs a life without any.
// interrupts: while he is awake, it ends the running action, so the brain
// credits that action with what the event did and decides afresh with the
// event still recent. Something he would turn toward; never sleep (that is
// a stimulus gene's `wakes` flag). The comment says why or why not.
//
// BLORB_STIM(id, name, source, situation, interrupts)
BLORB_STIM( 0, knock,          Body,  1, 1)  // the owner's hand on the dish: a cue he can learn to answer
BLORB_STIM( 1, double_knock,   Body,  0, 1)  // the owner's reward gesture; it must land on what he was doing
BLORB_STIM( 2, shake,          Body,  1, 1)  // punishment; credit goes to the action it cut short
BLORB_STIM( 3, picked_up,      Body,  1, 1)  // the world lurched; he turns to it
BLORB_STIM( 4, put_down,       Body,  0, 0)  // the end of a gesture, not a new one
BLORB_STIM( 5, dropped,        Body,  0, 1)  // it hurts now; blame the action it cut short
BLORB_STIM( 6, flipped,        Body,  0, 1)  // a rough handling, like a shake
BLORB_STIM( 7, righted,        Body,  0, 0)  // the end of a flip, not a new event
BLORB_STIM( 8, button,         Body,  0, 0)  // short press: a pellet (alive), next egg (clutch); pellet_dropped interrupts
BLORB_STIM( 9, button_hold,    Body,  0, 0)  // >= 1.2 s: tuck-in, or an armed phone consent; it soothes to sleep
BLORB_STIM(10, cradle,         Body,  1, 1)  // held still upright 3 s, then every 10 s; comfort to credit
BLORB_STIM(11, lid_down,       Body,  0, 0)  // face down for 2 s; bedtime acts through melatonin, slowly
BLORB_STIM(12, lid_up,         Body,  0, 0)  // light returning is no gesture
BLORB_STIM(13, touched,        Body,  0, 0)  // 1.46 only; no detector fires it yet
BLORB_STIM(16, pellet_dropped, World, 0, 1)  // food just appeared; he looks up and may go for it
BLORB_STIM(17, fed,            World, 1, 0)  // the Eat action reached a pellet; never phone-fired; fires mid-Eat
BLORB_STIM(18, fed_bad,        World, 0, 0)  // the pellet was rotten; fires mid-Eat, which earns the blame at its end
BLORB_STIM(19, marble_hit,     World, 1, 1)  // a toy reached him: the reward lands on the chase that won it
BLORB_STIM(20, dusk,           World, 0, 0)  // the clock turning is not an event in the dish
BLORB_STIM(21, dawn,           World, 0, 0)  // the clock turning is not an event in the dish
BLORB_STIM(22, owner_arrived,  World, 1, 1)  // someone came; he turns to greet them
BLORB_STIM(23, owner_left,     World, 0, 0)  // an absence, nothing to turn to
BLORB_STIM(32, self_called,    Self,  0, 0)  // his own action; it would cut itself short
BLORB_STIM(33, self_foresaw,   Self,  0, 0)  // his own action; it would cut itself short
BLORB_STIM(34, woke,           Self,  0, 0)  // the sleep just ended, so the brain already decides
BLORB_STIM(35, hatched,        Self,  0, 0)  // the first think already decides
BLORB_STIM(48, petted,         Phone, 1, 1)  // a stroke from the phone, the cradle's twin
BLORB_STIM(49, played,         Phone, 0, 0)  // a phone game owns the moment, not the brain
BLORB_STIM(50, spoken_to,      Phone, 0, 0)  // a voice is ambient; it soothes without demanding a turn
