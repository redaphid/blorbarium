// blorb.hypnodroid.com: one Worker, deployed from the repo root by Workers Builds
// (`npx wrangler deploy` on main, `npx wrangler preview` on other branches) or by hand
// with the same command. See web/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blorbarium",
  "main": "web/src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The site. Matched before the Worker runs; fw/ is left out (web/public/.assetsignore).
  "assets": { "directory": "./web/public", "binding": "ASSETS" },
  // The firmware releases: /fw/<board>/manifest.json and its image (tools/ota_release.py publish).
  "r2_buckets": [{ "binding": "FW", "bucket_name": "blorbarium-fw" }],
  "routes": [{ "pattern": "blorb.hypnodroid.com", "custom_domain": true }],
  // In Workers Builds (WORKERS_CI=1) every check runs before the upload, and a
  // failure stops it. Anywhere else (wrangler dev, a deploy by hand) this returns at once.
  "build": { "command": "bash scripts/ci/cloudflare-build.sh --workers-ci-only" }
}
